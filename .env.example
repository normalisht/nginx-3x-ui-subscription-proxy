# Server URLs to fetch subscriptions from (space-separated)
SERVERS="https://server1.com/sub/ https://server2.com/sub/"
EXTERNAL_SUBSCRIPTIONS="https://vpn-service.com/sub/your_id"
EXTERNAL_SUBSCRIPTION_HEADERS="User-Agent: Happ/2.4.1 (Android 13; SDK 33);;Hwid: 1234567890abcdef"

# Static part of the subscription path
SUB=sub

# Port for the Python server to listen on
PORT=8080

# Host domain (for reference, not used by Python script directly)
SITE_HOST=example.com
SITE_HOST_SECOND=tmp.example.com
EMAIL=some@mail.com

ROUTING_ENABLED=0