# Адреса подписок 3x-UI через пробел: к каждому дописывается id клиента из запроса.
# У клиента должен быть одинаковый subscription ID на всех серверах.
SERVERS="https://server1.com/sub/ https://server2.com/sub/"

# Готовые ссылки сторонних подписок через пробел — запрашиваются как есть. Необязательно.
EXTERNAL_SUBSCRIPTIONS=
# Заголовки для запросов к EXTERNAL_SUBSCRIPTIONS — имитация обычного VPN-клиента.
# Формат «Key: Value», несколько — через ;;
# EXTERNAL_SUBSCRIPTION_HEADERS="User-Agent: Happ/2.4.1 (Android 13; SDK 33);;Hwid: 1234567890abcdef"
# 1 — сторонние подписки отдают JSON-конфиги: они сливаются в один, SERVERS не используются.
EXTERNAL_SUBSCRIPTIONS_JSON=0

# Путь подписки: https://SITE_HOST/SUB/<subscription_ID>
SUB=sub
# Домен сервиса: на него выпускается сертификат и указывает ссылка на routing.json.
SITE_HOST=example.com
# 1 — добавлять в подписку ссылку на routing.json (правила маршрутизации для Happ и аналогов).
ROUTING_ENABLED=0
# Почта для Let's Encrypt (самостоятельный режим). Необязательно.
EMAIL=

# Режим за общим reverse-proxy (edge-proxy): HTTP без TLS, без портов наружу.
# COMPOSE_FILE=compose.edge.yaml
