# nginx для docker-compose.edge.yml: HTTP без TLS, только для общего reverse-proxy (edge).
# ${SUB} и ${PORT} подставляет envsubst образа nginx при старте контейнера.

resolver 127.0.0.11 valid=10s ipv6=off;

# Адрес клиента — из X-Real-IP, который выставляет edge (к контейнеру ходят только из сетей Docker).
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Real-IP;

upstream python_backend {
    zone python_backend 64k;
    # resolve — новый IP подхватывается после пересоздания контейнера бэкенда.
    server subproxy-python:${PORT} resolve;
    keepalive 8;
}

server {
    listen 80 default_server;
    server_tokens off;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # routing.json для клиентов (Happ и аналоги); ссылку на него бэкенд дописывает в каждую подписку.
    location /routing/ {
        root /usr/share/nginx/html;
    }

    # Обработка запросов с фиксированной частью пути и переменным sub_id
    location ~ ^/${SUB}/([^/]+)/?$ {
        proxy_pass http://python_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 30s;
        proxy_read_timeout 120s;
    }

    location / {
        return 404;
    }
}
