# Python equivalent of the nginx config_fetcher
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY config_fetcher.py .

# Note: SERVERS, SUB, PORT are set at runtime via docker-compose.yml env_file

EXPOSE 8080

CMD ["sh", "-c", "python config_fetcher.py"]
